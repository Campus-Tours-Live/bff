# Dependencies
node_modules

# Build output
dist
*.tsbuildinfo

# Exported OpenAPI spec (build artifact — regenerated by `npm run openapi:export`/`openapi:lint`)
openapi.json

# Test coverage
coverage

# Environment / secrets (keep the committed template)
.env
.env.*
!.env.example

# Husky internals (managed; regenerated on `npm install`)
.husky/_/

# Logs
*.log

# OS / editor noise
.DS_Store

# Claude Code — personal settings (do not commit); share .claude/settings.json
.claude/settings.local.json

# --- IntelliJ / WebStorm — ignore user-specific config, keep the shared bits ---
.idea/*
!.idea/externalDependencies.xml
*.iml

# --- Superpowers working artifacts — plans, specs, SDD ledgers, review write-ups ---
# They record how a change was arrived at, which goes stale the moment the code moves on. The
# code, its tests and README/CLAUDE.md are the shared source of truth. Keep these local.
# NOTE: docs/openapi-conventions.md is NOT this — it is real repo documentation that CLAUDE.md
# points contributors at, and it stays tracked.
.superpowers/
docs/superpowers/
